{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "create-react-app",
  "installCommand": "cd frontend && npm ci",
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/build",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/actividades/",
      "has": [{ "type": "query", "key": "slug", "value": "(?<slug>[^&]+)" }],
      "destination": "/actividades/:slug/",
      "permanent": true
    },
    { "source": "/taller-de-ceramica/", "destination": "/actividades/", "permanent": true },
    { "source": "/drenaje-linfatico-manual/", "destination": "/terapias-y-masajes/", "permanent": true },
    { "source": "/yoga-suave/", "destination": "/clases-de-yoga/", "permanent": true },
    { "source": "/reflexologia-podal/", "destination": "/terapias-y-masajes/", "permanent": true },
    { "source": "/ubicacion/", "destination": "/contacto/", "permanent": true },
    { "source": "/taller-cocina-festiva/", "destination": "/actividades/", "permanent": true },
    { "source": "/conferencias-y-talleres/", "destination": "/actividades/", "permanent": true },
    { "source": "/horarios/", "destination": "/clases-de-yoga/", "permanent": true },
    { "source": "/yoga-embarazo/", "destination": "/clases-de-yoga/", "permanent": true },
    { "source": "/yoga-crianza/", "destination": "/clases-de-yoga/", "permanent": true },
    { "source": "/masajes-y-terapias/", "destination": "/terapias-y-masajes/", "permanent": true },
    { "source": "/tecnica-metamorfica/", "destination": "/terapias-y-masajes/", "permanent": true },
    { "source": "/kirtan-conferencia/", "destination": "/actividades/", "permanent": true },
    { "source": "/masaje-terapeutico/", "destination": "/terapias-y-masajes/", "permanent": true },
    { "source": "/circulo-taller-entre-mujeres/", "destination": "/actividades/", "permanent": true }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "https://api.yogayterapiasarunachala.es/sitemap.xml"
    },
    {
      "source": "/.well-known/api-catalog",
      "destination": "/.well-known/api-catalog.json"
    },
    {
      "source": "/.well-known/api-catalog/",
      "destination": "/.well-known/api-catalog.json"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Link",
          "value": "<https://www.yogayterapiasarunachala.es/.well-known/ai-catalog.json>; rel=\"ai-catalog\", <https://www.yogayterapiasarunachala.es/.well-known/ard.json>; rel=\"ard\", <https://www.yogayterapiasarunachala.es/.well-known/api-catalog>; rel=\"api-catalog\"; type=\"application/linkset+json\", <https://www.yogayterapiasarunachala.es/llms.txt>; rel=\"describedby\"; type=\"text/plain\""
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Link",
          "value": "<https://www.yogayterapiasarunachala.es/.well-known/ai-catalog.json>; rel=\"ai-catalog\", <https://www.yogayterapiasarunachala.es/.well-known/ard.json>; rel=\"ard\", <https://www.yogayterapiasarunachala.es/.well-known/api-catalog>; rel=\"api-catalog\"; type=\"application/linkset+json\""
        }
      ]
    },
    {
      "source": "/.well-known/api-catalog",
      "headers": [
        { "key": "Content-Type", "value": "application/linkset+json; charset=utf-8" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/.well-known/api-catalog/",
      "headers": [
        { "key": "Content-Type", "value": "application/linkset+json; charset=utf-8" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/openapi.json",
      "headers": [
        { "key": "Content-Type", "value": "application/openapi+json; charset=utf-8" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/.well-known/(ai-catalog.json|ard.json|mcp.json|agent.json)",
      "headers": [
        { "key": "Content-Type", "value": "application/json; charset=utf-8" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/.well-known/mcp/server-card.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json; charset=utf-8" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/mcp/server-card.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json; charset=utf-8" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/.well-known/api-catalog.json",
      "headers": [
        { "key": "Content-Type", "value": "application/linkset+json; charset=utf-8" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/.well-known/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/gallery/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/(.*\\.(webp|png|jpg|jpeg|gif|svg|ico))",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ]
}
